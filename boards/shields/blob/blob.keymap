#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";
        combo_bootloader {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&bootloader>;
        };
        combo_reset {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&sys_reset>;
        };
        combo_output {
            timeout-ms = <50>;
            key-positions = <0 2>;
            bindings = <&out OUT_TOG>;
        };
        combo_bt_clear {
            timeout-ms = <50>;
            key-positions = <0 3>;
            bindings = <&bt BT_CLR>;
        };
    };

    // ┌───┬───┬───┬───┐
    // │ 0 │ 1 │ 2 │ 3 │
    // └───┴───┴───┴───┘
    //      ╭─────╮
    //      │  7  │      ← encoder, push = 7
    //      ╰─────╯
    //   ┌───┬───┬───┐
    //   │ 4 │ 5 │ 6 │
    //   └───┴───┴───┘
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    &kp A    &kp B    &kp C    &kp D
    &kp F    &kp G    &kp H    &kp I
            >;

            sensor-bindings = <&inc_dec_kp K L>;
        };
    };
};
